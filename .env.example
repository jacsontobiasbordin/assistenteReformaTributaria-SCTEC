LLM_PROVIDER=gemini

# Gemini (Google AI Studio) - provedor padrao do projeto
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3-flash

# Claude (Anthropic) - usado se LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
