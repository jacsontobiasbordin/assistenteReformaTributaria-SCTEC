LLM_PROVIDER=gemini

# Gemini (Google AI Studio) - provedor padrao do projeto
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3-flash

# Claude (Anthropic) - usado se LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI - usado se LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1

# Timeout (em segundos) da chamada ao LLM em gerar_analise
LLM_TIMEOUT_SECONDS=30

# Porta local da API (uvicorn app.web.main:app), opcional
APP_PORT=8000

# URL do webhook do n8n local (n8n/docker-compose.yml) chamado apos
# aprovacao humana do cenario de calculo de impostos (Etapa 7). Estas
# duas SIM sao usadas pela aplicacao Python (app/tools/notificacao.py).
N8N_WEBHOOK_URL=http://localhost:5678/webhook/reformatax-aprovacao
N8N_TIMEOUT_SECONDS=10

APP_ENV=development

# n8n local (docker-compose em n8n/) — nao usado pela aplicacao Python,
# apenas para autenticar na interface web do n8n em localhost:5678
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
